# Глобальные настройки
root = true

[*]
indent_style = space
indent_size = 4
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.cs]
# --- ПРАВИЛА ИМЕНОВАНИЯ (Naming Styles) ---

# Приватные поля через нижнее подчеркивание (например, _userRepository)
dotnet_naming_rule.private_members_with_underscore.symbols = private_fields
dotnet_naming_rule.private_members_with_underscore.style = prefix_underscore
dotnet_naming_rule.private_members_with_underscore.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.prefix_underscore.capitalization = camel_case
dotnet_naming_style.prefix_underscore.required_prefix = _

# Публичные члены (методы, свойства) — PascalCase
dotnet_naming_rule.pascal_case_for_public_members.symbols = public_members
dotnet_naming_rule.pascal_case_for_public_members.style = pascal_case
dotnet_naming_rule.pascal_case_for_public_members.severity = warning

dotnet_naming_symbols.public_members.applicable_kinds = property, method, event, field
dotnet_naming_symbols.public_members.applicable_accessibilities = public, internal, protected

dotnet_naming_style.pascal_case.capitalization = pascal_case

# --- ПРЕДПОЧТЕНИЯ ЯЗЫКА (Code Style) ---

# Использовать var везде, где тип очевиден
dotnet_style_qualification_for_field = false:silent
dotnet_style_qualification_for_property = false:silent
dotnet_style_qualification_for_method = false:silent
dotnet_style_qualification_for_event = false:silent

# Предпочитать 'var', если тип ясен из правой части (new, cast)
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Использование Expression-bodied members (короткие записи => для методов из одной строки)
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# --- ФОРМАТИРОВАНИЕ (Formatting) ---

# Перенос фигурной скобки на новую строку (Allman style)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Пробелы
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_call_parameter_list_parentheses = false

# Организация using (системные в начале, по алфавиту)
dotnet_separate_import_directive_groups = false
dotnet_sort_system_directives_first = true